#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:7
msgid "How do I set different prices for different user roles?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:8
msgid "Enable the plugin in Settings → General, then use one of two methods: Multipliers (percentage-based adjustments across all products) or Per Product settings (exact prices set directly on each product's edit page for specific roles)."
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:11
msgid "What is the difference between Multipliers and Per Product pricing?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:12
msgid "Multipliers apply a single multiplier value across all products for a given role. Per Product pricing lets you set exact prices directly on each product's edit page for specific roles, giving you granular per-product control."
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:15
msgid "What does 'Make empty price' mean?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:16
msgid "When \"Make empty price\" is enabled for a role in Multipliers or Per Product settings, the product price is hidden entirely for that role."
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:19
msgid "Why should I disable the plugin for search engine bots?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:20
msgid "Search engines index product prices. If bots see role-specific prices (e.g. a restricted or empty price), it can affect SEO and how products appear in search results. Disabling for bots ensures crawlers always see standard WooCommerce prices."
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:23
msgid "What happens if I have both Multipliers and Per Product pricing enabled?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:24
msgid "Per Product prices take precedence over Multipliers by default. If a product has a per-product price set for a role, that price is used. Otherwise, the Multiplier is applied to the standard WooCommerce price."
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:27
msgid "Can I apply role-based pricing to shipping costs?"
msgstr ""

#: build/admin.js:1
#: dist/price-by-user-role-for-woocommerce/build/admin.js:1
#: src/admin/pages/faqs/index.js:28
msgid "Yes. In Settings → Multipliers, enable the \"Apply to Shipping\" option. The same multiplier configured for a role's product prices will also be applied to shipping costs at checkout."
msgstr ""

